# Build output
build/
out/
bin/
lib/

# vcpkg installed packages (reproduced by vcpkg on configure)
vcpkg_installed/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/

# Visual Studio
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj.filters

# Compiled objects & binaries
*.obj
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp

# Compiled shaders
*.cso
*.fxo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Log files
*.log
logs/

# Crash dumps
*.dmp
*.mdmp

# Atomic write temps (SaveSystem)
*.tmp

# PIX GPU captures (devrel profiling)
*.wpix
*.vspx

# Clangd compile database (generated by CMake)
compile_commands.json

# Import sidecars — generated alongside .easset, not source
*.meta

# Per-user editor preferences (not project config)
editor_prefs.toml

# Cooked assets — reproduced by asset_cooker from source .glb/.png
*.easset
